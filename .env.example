LEGACY_ASSET_SYNC_READ_ONLY=true
LEGACY_ASSET_SYNC_BASE_URL=https://ams.bearrental.com
LEGACY_ASSET_SYNC_APP_ID=
LEGACY_ASSET_SYNC_APP_SECRET=
# Optional: use the permissions of this legacy AMS login instead of super-admin scope.
